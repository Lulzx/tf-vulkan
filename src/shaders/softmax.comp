#version 450
// Numerically stable row softmax (spec §7 K1): one workgroup per row.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer A { float a[]; };
layout(set = 0, binding = 1) buffer C { float c[]; };
layout(push_constant) uniform PC {
    uint rows; uint cols; uint aOff; uint cOff; uint pad0; uint pad1; uint pad2; uint pad3;
} pc;
shared float sdata[256];
void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.rows) return;
    uint tid = gl_LocalInvocationID.x;
    float m = -3.402823466e+38;
    for (uint i = tid; i < pc.cols; i += 256u) m = max(m, a[pc.aOff + row * pc.cols + i]);
    sdata[tid] = m; barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) { if (tid < s) sdata[tid] = max(sdata[tid], sdata[tid + s]); barrier(); }
    float mx = sdata[0];
    float sum = 0.0;
    for (uint i = tid; i < pc.cols; i += 256u) sum += exp(a[pc.aOff + row * pc.cols + i] - mx);
    sdata[tid] = sum; barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) { if (tid < s) sdata[tid] += sdata[tid + s]; barrier(); }
    float denom = sdata[0];
    for (uint i = tid; i < pc.cols; i += 256u)
        c[pc.cOff + row * pc.cols + i] = exp(a[pc.aOff + row * pc.cols + i] - mx) / denom;
}
