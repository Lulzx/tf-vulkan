#version 450
// Unary pointwise ops. op: 0 Identity 1 Relu 2 Relu6 3 Sigmoid 4 Tanh
// 5 Exp 6 Log 7 Sqrt 8 Neg 9 Abs 10 CastF32 11 Square
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer A { float a[]; };
layout(set = 0, binding = 1) buffer C { float c[]; };
layout(push_constant) uniform PC {
    uint numel; uint op; uint aOff; uint cOff; uint pad0; uint pad1; uint pad2; uint pad3;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numel) return;
    float x = a[pc.aOff + i];
    float r;
    switch (pc.op) {
        case 1u: r = max(x, 0.0); break;
        case 2u: r = clamp(x, 0.0, 6.0); break;
        case 3u: r = 1.0 / (1.0 + exp(-x)); break;
        case 4u: r = tanh(x); break;
        case 5u: r = exp(x); break;
        case 6u: r = log(x); break;
        case 7u: r = sqrt(x); break;
        case 8u: r = -x; break;
        case 9u: r = abs(x); break;
        case 11u: r = x * x; break;
        default: r = x; break;
    }
    c[pc.cOff + i] = r;
}
