#version 450
// Tiled FP32 MatMul with shared memory (spec §7). Non-transposed inputs only;
// transposed/batched cases use matmul.comp.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) readonly buffer A { float a[]; };
layout(set = 0, binding = 1) readonly buffer B { float b[]; };
layout(set = 0, binding = 2) buffer C { float c[]; };
layout(push_constant) uniform PC {
    uint M; uint N; uint K; uint transA; uint transB; uint aOff; uint bOff; uint cOff;
} pc;
shared float ta[16][16];
shared float tb[16][16];
void main() {
    uint col = gl_GlobalInvocationID.x, row = gl_GlobalInvocationID.y;
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    float acc = 0.0;
    for (uint t = 0; t < pc.K; t += 16u) {
        ta[ly][lx] = (row < pc.M && t + lx < pc.K) ? a[pc.aOff + row * pc.K + t + lx] : 0.0;
        tb[ly][lx] = (t + ly < pc.K && col < pc.N) ? b[pc.bOff + (t + ly) * pc.N + col] : 0.0;
        barrier();
        for (uint k = 0; k < 16u; ++k) acc += ta[ly][k] * tb[k][lx];
        barrier();
    }
    if (row < pc.M && col < pc.N) c[pc.cOff + row * pc.N + col] = acc;
}
