#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X { float16_t x[]; };
layout(set = 0, binding = 1) readonly buffer B { float16_t bias[]; };
layout(set = 0, binding = 2) buffer C { float16_t c[]; };
layout(push_constant) uniform PC {
    uint numel; uint channels; uint xOff; uint bOff; uint cOff; uint pad0; uint pad1; uint pad2;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numel) return;
    c[pc.cOff + i] = float16_t(float(x[pc.xOff + i]) + float(bias[pc.bOff + (i % pc.channels)]));
}
