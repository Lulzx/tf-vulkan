#version 450
// BiasAdd for NHWC / [rows, channels] FP32 (spec §7 K0).
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer B { float bias[]; };
layout(set = 0, binding = 2) buffer C { float c[]; };
layout(push_constant) uniform PC {
    uint numel; uint channels; uint xOff; uint bOff; uint cOff; uint pad0; uint pad1; uint pad2;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numel) return;
    c[pc.cOff + i] = x[pc.xOff + i] + bias[pc.bOff + (i % pc.channels)];
}
