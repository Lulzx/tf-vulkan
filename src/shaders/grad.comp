#version 450
// Gradient helpers (§7 K1/P3): out = grad * (x > 0) for ReluGrad.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer G { float g[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) buffer C { float c[]; };
layout(push_constant) uniform PC {
    uint numel; uint op; uint p0; uint p1; uint p2; uint p3; uint p4; uint p5;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numel) return;
    c[i] = x[i] > 0.0 ? g[i] : 0.0;
}
